# No private keys, no transaction signing, no automatic billing.
# Optional: use an existing free Helius API key, backend only.
HELIUS_API_KEY=
# Used if no Helius key is supplied:
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
DB_PATH=data/sol-signal.sqlite
API_HOST=127.0.0.1
API_PORT=8787
RPC_REQUEST_INTERVAL_MS=500
RPC_DAILY_REQUEST_LIMIT=20000
# Known CEX/router/pool addresses to filter from evidence graph (comma separated)
GRAPH_BLOCKED_ADDRESSES=
# Optional read-only fallback; must already be available to you. No automatic paid account.
SOLANA_BACKUP_RPC_URL=
# Separate provider required for independent reconciliation; same host is rejected.
AUDIT_RPC_URL=
# maxActiveTokens (1–4) is edited in the dashboard; the legacy pool cap is ignored.
CANDIDATE_WATCH_SECONDS=300
# Optional, inactive without BOTH verified circulation evidence and validated coverage.
# Never put keys in VITE_* or Git. Quote v1 is deprecated compatibility, GET-only.
JUPITER_API_KEY=
CIRCULATION_FILE=


# Model runtime removed: no AI, OpenAI or Codex credentials are read.
# Free mode: keep core wallets; opt-in candidate pool traffic needs adequate RPC capacity.
CANDIDATE_POOL_MONITORING=false

# Optional isolated provider benchmark (disabled; no automatic registration/purchase).
PROVIDER_COMPARE_ENABLED=false
BITQUERY_ACCESS_TOKEN=
COMPARE_SCOPE_JSON=[]
COMPARE_SECONDS=60
