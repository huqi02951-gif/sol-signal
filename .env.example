# No private keys, no transaction signing, no automatic billing.
# Optional: use an existing free Helius API key, backend only.
HELIUS_API_KEY=
# Used if no Helius key is supplied:
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
DB_PATH=data/sol-signal.sqlite
API_HOST=127.0.0.1
API_PORT=8787
RPC_REQUEST_INTERVAL_MS=500
RPC_DAILY_REQUEST_LIMIT=20000
# Known CEX/router/pool addresses to filter from evidence graph (comma separated)
GRAPH_BLOCKED_ADDRESSES=
